# Copy to .env on the server and fill in. docker compose reads it; never commit the real .env.

# Which published image the server runs (deploy/docker-compose.server.yml); "latest" follows main
SMS_GATEWAY_IMAGE=ghcr.io/siveing/sms-service:latest

# Console sign-in (the app refuses every sign-in while this is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Database password, used when the database is first created; change before the first start
DB_PASSWORD=

# The address apps and phones use from outside, e.g. https://sms.example.com
PUBLIC_URL=

# Host port the gateway listens on
PORT=8094

# Telegram test delivery (optional): bot token from @BotFather, the group's chat id, a topic number
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

TIME_ZONE=Asia/Phnom_Penh
